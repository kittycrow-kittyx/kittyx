{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KITTYX project dependency manifest",
  "type": "object",
  "required": [
    "schema",
    "dependencies"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "repository",
          "path",
          "commit",
          "relationship",
          "direct",
          "updatePolicy"
        ]
      }
    }
  }
}
